# Copy to .env and fill in. .env is gitignored.
# Config YAML can reference these via ${VAR} (see config.example.yaml).

# Required when model.provider is "openai"
OPENAI_API_KEY=

# Host path to the Obsidian vault — used by docker-compose.yml as the volume source
# (${OBSIDIAN_VAULT_PATH}:/vault). Inside the container, config should keep
# app.obsidian_vault_path: "/vault" (not this env var).
# For local runs without Docker, set app.obsidian_vault_path in config.yaml to the host path instead.
# OBSIDIAN_VAULT_PATH=

# Optional frontend overrides (Parcel). Defaults talk to local backend.
# API_URL=http://127.0.0.1:8765
# WS_URL=ws://127.0.0.1:8765
