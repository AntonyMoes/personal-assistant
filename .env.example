# Copy to .env and set your host Obsidian vault path (absolute path recommended).
# Docker Compose mounts this directory at /vault inside the backend container.
#
# macOS / Linux example:
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/ObsidianVault
#
# Windows (Docker Desktop) example:
# OBSIDIAN_VAULT_PATH=C:/Users/you/Documents/ObsidianVault

OBSIDIAN_VAULT_PATH=
